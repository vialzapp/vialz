{
  "manifest_version": 3,
  "name": "Vialz: token check for Robinhood Chain",
  "short_name": "Vialz",
  "description": "Click the icon on a token page to see snipers, the bundle, linked wallets and the dev's bag, read from Robinhood Chain.",
  "version": "1.0.1",
  "minimum_chrome_version": "110",
  "homepage_url": "https://vialz.xyz",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Check a token with Vialz",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": [
    "activeTab",
    "storage"
  ]
}
