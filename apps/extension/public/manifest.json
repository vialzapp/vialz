{
  "manifest_version": 3,
  "name": "Vialz: token check for Robinhood Chain",
  "short_name": "Vialz",
  "description": "Paste a contract address and see snipers, bundles, linked wallets and the creator's record, read from Robinhood Chain.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_title": "Open Vialz", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["sidePanel", "activeTab", "storage"]
}
